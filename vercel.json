{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/tutor.js": {
      "maxDuration": 120
    },
    "api/recommendations.js": {
      "maxDuration": 30,
      "includeFiles": "server/rag/data/**"
    },
    "api/analysis.js": {
      "maxDuration": 120
    },
    "api/explanation.js": {
      "maxDuration": 120,
      "includeFiles": "{public/images/keyword/**,server/rag/data/**}"
    }
  }
}
